{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude Trader",
  "version": "0.1.0",
  "identifier": "app.claudetrader.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Claude Trader",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../../extension": "extension"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNDNzI3RTJGNUVGMzVCMzAKUldRd1cvTmVMMzV5UEI0T2xjSURBTXYzMnp1OEpyZyt0aEFaTHcwMW8zR0FKMXVwS2pHck1DVzIK",
      "endpoints": [
        "https://github.com/Drewzyy/Ps5Bot/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
