{
  "manifest_version": 3,
  "name": "Claude Trader",
  "version": "0.2.0",
  "description": "Side panel, coin checks, tab help and an optional read-only X Monitor for the Claude Trader desktop app. Paper trading only.",
  "key": "",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Claude Trader",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "notifications",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://api.dexscreener.com/*",
    "https://x.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://pump.fun/*",
        "https://www.pump.fun/*",
        "https://dexscreener.com/solana/*",
        "https://www.dexscreener.com/solana/*"
      ],
      "js": [
        "lib/mint.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://x.com/*"
      ],
      "js": [
        "xhook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://x.com/*"
      ],
      "js": [
        "lib/xparse.js",
        "xcontent.js"
      ],
      "run_at": "document_start"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src ws://127.0.0.1:8766 https://api.dexscreener.com"
  }
}
